{
  "name": "pair-notebook",
  "displayName": "Pair Notebook",
  "description": "Encrypted VS Code and Jupyter collaboration with pinned host execution, VPN recovery, direct WebRTC, and redundant Nostr/MQTT relay fallback.",
  "version": "0.5.13",
  "publisher": "pair-notebook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r7zex/jupyter_pair_ext.git"
  },
  "homepage": "https://github.com/r7zex/jupyter_pair_ext#readme",
  "bugs": {
    "url": "https://github.com/r7zex/jupyter_pair_ext/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "collaboration",
    "jupyter",
    "yjs",
    "trystero",
    "webrtc",
    "nostr",
    "mqtt",
    "crdt",
    "remote execution",
    "pair programming"
  ],
  "activationEvents": [
    "onView:pairNotebook.dashboard",
    "workspaceContains:.pair-notebook-session.json"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pair Notebook exchanges project files and launches Python kernels on the session host, so the workspace must be trusted first."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pairNotebook.startSession",
        "title": "Pair Notebook: Start Session"
      },
      {
        "command": "pairNotebook.joinSession",
        "title": "Pair Notebook: Join Session"
      },
      {
        "command": "pairNotebook.leaveSession",
        "title": "Pair Notebook: Leave Session"
      },
      {
        "command": "pairNotebook.endSession",
        "title": "Pair Notebook: End Session for Everyone"
      },
      {
        "command": "pairNotebook.copyInvite",
        "title": "Pair Notebook: Copy Invite"
      },
      {
        "command": "pairNotebook.openPanel",
        "title": "Pair Notebook: Open Session Panel"
      },
      {
        "command": "pairNotebook.transferHost",
        "title": "Pair Notebook: Transfer Host"
      },
      {
        "command": "pairNotebook.showDiagnostics",
        "title": "Pair Notebook: Show Network Diagnostics"
      },
      {
        "command": "pairNotebook.tryImproveConnection",
        "title": "Pair Notebook: Try To Improve Connection"
      },
      {
        "command": "pairNotebook.setTurnPassword",
        "title": "Pair Notebook: Set TURN Password"
      },
      {
        "command": "pairNotebook.setProxyPassword",
        "title": "Pair Notebook: Set Proxy Password"
      },
      {
        "command": "pairNotebook.selectBackingFolder",
        "title": "Pair Notebook: Select Backing Folder"
      },
      {
        "command": "pairNotebook.flush",
        "title": "Pair Notebook: Flush to Backing Folder"
      },
      {
        "command": "pairNotebook.selectAutosaveFolder",
        "title": "Pair Notebook: Select Local Autosave Folder"
      },
      {
        "command": "pairNotebook.createAutosave",
        "title": "Pair Notebook: Create Local Autosave Now"
      },
      {
        "command": "pairNotebook.reconnect",
        "title": "Pair Notebook: Reconnect"
      },
      {
        "command": "pairNotebook.changeCompute",
        "title": "Pair Notebook: Change Compute"
      },
      {
        "command": "pairNotebook.refreshHardware",
        "title": "Pair Notebook: Refresh Hardware"
      },
      {
        "command": "pairNotebook.showComputeResources",
        "title": "Pair Notebook: Show Compute Resources"
      },
      {
        "command": "pairNotebook.selectPythonEnvironment",
        "title": "Pair Notebook: Select Python Environment"
      },
      {
        "command": "pairNotebook.runActiveCell",
        "title": "Pair Notebook: Run Active Cell on Compute",
        "enablement": "pairNotebook.inSession && pairNotebook.executionAvailable"
      },
      {
        "command": "pairNotebook.restartKernel",
        "title": "Pair Notebook: Restart Jupyter Kernel",
        "enablement": "pairNotebook.inSession && pairNotebook.executionAvailable"
      },
      {
        "command": "pairNotebook.openRecentProject",
        "title": "Pair Notebook: Open Recent Project"
      },
      {
        "command": "pairNotebook.showAdvancedDiagnostics",
        "title": "Pair Notebook: Run Advanced Network Diagnostics"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pairNotebook",
          "title": "Pair Notebook",
          "icon": "media/pair-notebook.svg"
        }
      ]
    },
    "views": {
      "pairNotebook": [
        {
          "id": "pairNotebook.dashboard",
          "name": "Pair Notebook",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "notebook/cell/title": [
        {
          "command": "pairNotebook.runActiveCell",
          "group": "navigation@20",
          "when": "pairNotebook.inSession && pairNotebook.executionAvailable"
        }
      ]
    },
    "configuration": {
      "title": "Pair Notebook",
      "properties": {
        "pairNotebook.displayName": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Default name shown in the start/join prompt. Pair Notebook always asks before entering a session."
        },
        "pairNotebook.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python executable used when this computer is the session host."
        },
        "pairNotebook.selectedCudaDevice": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine",
          "description": "CUDA device index exposed to the Pair Notebook Python kernel."
        },
        "pairNotebook.persistenceDebounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "maximum": 5000,
          "scope": "application",
          "description": "Host-folder write debounce. It never delays live network updates or repeatedly force-saves the open editor."
        },
        "pairNotebook.autosaveFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Host-only local recovery folder. Empty uses C:\\Temp\\PairNotebook\\autosaves on Windows. A snapshot is created every five minutes and only the latest three are retained."
        },
        "pairNotebook.logLevel": {
          "type": "string",
          "enum": [
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "scope": "application"
        },
        "pairNotebook.turnUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Optional custom TURN relay URLs (turn:/turns:), tried in order UDP, TCP, TLS. Pair Notebook has no built-in TURN service; direct ICE and the encrypted emergency relay remain available when this is empty."
        },
        "pairNotebook.turnUsername": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Username for the custom TURN servers. Store the password with 'Pair Notebook: Set TURN Password' so it never appears in settings or logs."
        },
        "pairNotebook.proxyUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^(?:|(?:[Hh][Tt][Tt][Pp][Ss]?|[Ss][Oo][Cc][Kk][Ss](?:4[Aa]?|5[Hh]?))://(?:[^\\s:/@]+@)?(?:\\[[^\\]\\s]+\\]|[^\\s/:@?#]+)(?::[0-9]{1,5})?/?)$",
          "patternErrorMessage": "Do not put a proxy password in settings. Keep only the endpoint and optional username here, then run 'Pair Notebook: Set Proxy Password'.",
          "description": "Optional HTTP(S), SOCKS4 or SOCKS5 proxy endpoint plus optional username for signalling and encrypted relay fallback (for example http://user@127.0.0.1:10809). Store its password with 'Pair Notebook: Set Proxy Password'. Pair Notebook otherwise uses VS Code, environment and Windows system proxy settings automatically."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf out",
    "compile": "rimraf out && tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --define:process.env.WS_NO_BUFFER_UTIL=\"'1'\" --define:process.env.WS_NO_UTF_8_VALIDATE=\"'1'\" --outfile=out/extension.js --sourcemap",
    "lint": "eslint .",
    "test": "npm run compile && mocha --timeout 15000 --exit \"out/test/**/*.test.js\"",
    "test:live": "npm run compile && node scripts/trystero-live-smoke.mjs",
    "test:live:relay": "npm run compile && node scripts/emergency-relay-live-smoke.mjs",
    "package": "npm run clean && npm run lint && npm test && node scripts/make-artifacts.mjs --preflight-only && vsce package --no-yarn --no-dependencies --no-rewrite-relative-links --allow-missing-repository",
    "artifacts": "npm run package && node scripts/make-artifacts.mjs",
    "test:live:mqtt": "node scripts/mqtt-live-smoke.mjs"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.1.0",
    "@trystero-p2p/core": "^0.25.3",
    "debug": "^4.4.3",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "mqtt": "^5.15.2",
    "socks-proxy-agent": "^8.0.5",
    "trystero": "^0.25.3",
    "werift": "^0.24.4",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "mocha": "^11.7.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
