{
  "name": "pair-notebook",
  "displayName": "Pair Notebook",
  "description": "Collaborative files and Jupyter notebooks with encrypted peer sessions, persistent server workspaces and controlled remote Python execution.",
  "version": "0.6.9",
  "publisher": "pair-notebook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r7zex/jupyter_pair_ext.git"
  },
  "homepage": "https://github.com/r7zex/jupyter_pair_ext#readme",
  "bugs": {
    "url": "https://github.com/r7zex/jupyter_pair_ext/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "collaboration",
    "jupyter",
    "yjs",
    "trystero",
    "webrtc",
    "nostr",
    "mqtt",
    "crdt",
    "remote execution",
    "pair programming"
  ],
  "activationEvents": [
    "onView:pairNotebook.dashboard",
    "onFileSystem:pair-vps",
    "workspaceContains:.pair-notebook-session.json"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pair Notebook stays loaded only to preserve an explicit Start/Join handoff while VS Code asks for Workspace Trust. Session networking, synchronization, and execution remain blocked until the folder is trusted."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pairNotebook.startSession",
        "title": "Pair Notebook: Start Session"
      },
      {
        "command": "pairNotebook.joinSession",
        "title": "Pair Notebook: Join Session"
      },
      {
        "command": "pairNotebook.leaveSession",
        "title": "Pair Notebook: Leave Session"
      },
      {
        "command": "pairNotebook.endSession",
        "title": "Pair Notebook: End Session for Everyone"
      },
      {
        "command": "pairNotebook.copyInvite",
        "title": "Pair Notebook: Copy Invite"
      },
      {
        "command": "pairNotebook.openPanel",
        "title": "Pair Notebook: Open Session Panel"
      },
      {
        "command": "pairNotebook.transferHost",
        "title": "Pair Notebook: Transfer Host"
      },
      {
        "command": "pairNotebook.showDiagnostics",
        "title": "Pair Notebook: Show Network Diagnostics"
      },
      {
        "command": "pairNotebook.tryImproveConnection",
        "title": "Pair Notebook: Try To Improve Connection"
      },
      {
        "command": "pairNotebook.setTurnPassword",
        "title": "Pair Notebook: Set TURN Password"
      },
      {
        "command": "pairNotebook.setProxyPassword",
        "title": "Pair Notebook: Set Proxy Password"
      },
      {
        "command": "pairNotebook.selectBackingFolder",
        "title": "Pair Notebook: Select Backing Folder"
      },
      {
        "command": "pairNotebook.flush",
        "title": "Pair Notebook: Flush to Backing Folder"
      },
      {
        "command": "pairNotebook.selectAutosaveFolder",
        "title": "Pair Notebook: Select Local Autosave Folder"
      },
      {
        "command": "pairNotebook.createAutosave",
        "title": "Pair Notebook: Create Local Autosave Now"
      },
      {
        "command": "pairNotebook.reconnect",
        "title": "Pair Notebook: Reconnect"
      },
      {
        "command": "pairNotebook.changeCompute",
        "title": "Pair Notebook: Change Compute"
      },
      {
        "command": "pairNotebook.refreshHardware",
        "title": "Pair Notebook: Refresh Hardware"
      },
      {
        "command": "pairNotebook.showComputeResources",
        "title": "Pair Notebook: Show Compute Resources"
      },
      {
        "command": "pairNotebook.selectPythonEnvironment",
        "title": "Pair Notebook: Select Python Environment"
      },
      {
        "command": "pairNotebook.runActiveCell",
        "title": "Pair Notebook: Run Active Cell on Compute",
        "enablement": "(pairNotebook.inSession && pairNotebook.executionAvailable) || pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.restartKernel",
        "title": "Pair Notebook: Restart Jupyter Kernel",
        "enablement": "(pairNotebook.inSession && pairNotebook.executionAvailable) || pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.openRecentProject",
        "title": "Pair Notebook: Open Recent Project"
      },
      {
        "command": "pairNotebook.showAdvancedDiagnostics",
        "title": "Pair Notebook: Run Advanced Network Diagnostics"
      },
      {
        "command": "pairNotebook.connectVps",
        "title": "Pair Notebook: Connect to Server",
        "icon": "$(plug)"
      },
      {
        "command": "pairNotebook.connectVpsCompute",
        "title": "Pair Notebook: Connect to Server Compute",
        "icon": "$(remote)"
      },
      {
        "command": "pairNotebook.createVpsSession",
        "title": "Pair Notebook: Create Server Project",
        "icon": "$(add)"
      },
      {
        "command": "pairNotebook.joinVpsSession",
        "title": "Pair Notebook: Join Persistent Server Session"
      },
      {
        "command": "pairNotebook.manageVpsSession",
        "title": "Pair Notebook: Manage Server Project"
      },
      {
        "command": "pairNotebook.leaveVpsSession",
        "title": "Pair Notebook: Leave Server Project",
        "enablement": "pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.uploadVpsFolder",
        "title": "Pair Notebook: Upload Files to Server",
        "enablement": "pairNotebook.inVpsSession && pairNotebook.vpsOwner"
      },
      {
        "command": "pairNotebook.selectVpsCompute",
        "title": "Pair Notebook: Select Persistent Compute Device",
        "enablement": "pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.shareVpsComputer",
        "title": "Pair Notebook: Share My Computer in Server Session",
        "enablement": "pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.recoverVpsExecution",
        "title": "Pair Notebook: Recover Persistent Execution",
        "enablement": "pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.restartVpsKernel",
        "title": "Pair Notebook: Restart Persistent Notebook Kernel",
        "enablement": "pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.releaseVpsKernel",
        "title": "Pair Notebook: Release Persistent Notebook Kernel",
        "enablement": "pairNotebook.inVpsSession"
      },
      {
        "command": "pairNotebook.refreshVpsSession",
        "title": "Pair Notebook: Refresh Persistent Server Session",
        "icon": "$(refresh)"
      },
      {
        "command": "pairNotebook.vpsFolderPublic",
        "title": "Pair Notebook: Make Server Folder Public",
        "enablement": "pairNotebook.vpsOwner"
      },
      {
        "command": "pairNotebook.vpsFolderPrivate",
        "title": "Pair Notebook: Make Server Folder Private",
        "enablement": "pairNotebook.vpsOwner"
      },
      {
        "command": "pairNotebook.runVpsJob",
        "title": "Pair Notebook: Run Python on Server Compute",
        "icon": "$(play)"
      },
      {
        "command": "pairNotebook.showVpsJobs",
        "title": "Pair Notebook: Show Server Jobs",
        "icon": "$(tasklist)"
      },
      {
        "command": "pairNotebook.cancelVpsJob",
        "title": "Pair Notebook: Cancel Server Job",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pairNotebook.stopVpsSession",
        "title": "Pair Notebook: Emergency Stop Background Jobs in Current Session"
      },
      {
        "command": "pairNotebook.stopInteractiveSession",
        "title": "Pair Notebook: Emergency Stop Interactive Computations in Current Session"
      },
      {
        "command": "pairNotebook.refreshVpsJobs",
        "title": "Pair Notebook: Refresh Server Compute",
        "icon": "$(refresh)"
      },
      {
        "command": "pairNotebook.openSharedTerminal",
        "title": "Pair Notebook: Open Shared Host Terminal",
        "enablement": "pairNotebook.inSession"
      },
      {
        "command": "pairNotebook.startComputeSession",
        "title": "Pair Notebook: Start New Standalone Compute Session"
      },
      {
        "command": "pairNotebook.managePermissions",
        "title": "Pair Notebook: РџСЂР°РІР° СѓС‡Р°СЃС‚РЅРёРєРѕРІ"
      },
      {
        "command": "pairNotebook.addLineComment",
        "title": "Pair Notebook: РљРѕРјРјРµРЅС‚Р°СЂРёР№ Рє СЃС‚СЂРѕРєР°Рј"
      },
      {
        "command": "pairNotebook.resolveLineComment",
        "title": "Pair Notebook: Р—Р°РєСЂС‹С‚СЊ РєРѕРјРјРµРЅС‚Р°СЂРёР№"
      },
      {
        "command": "pairNotebook.configureVpsSessions",
        "title": "Pair Notebook: Configure Server Connections"
      },
      {
        "command": "pairNotebook.forgetAllConnections",
        "title": "Pair Notebook: Forget All Connections and Local Caches"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pairNotebook",
          "title": "Pair Notebook",
          "icon": "media/pair-notebook.svg"
        }
      ]
    },
    "views": {
      "pairNotebook": [
        {
          "id": "pairNotebook.dashboard",
          "name": "Pair Notebook",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "pairNotebook.vpsFolderPublic",
          "when": "resourceScheme == pair-vps && explorerResourceIsFolder && pairNotebook.vpsOwner",
          "group": "pairNotebook@1"
        },
        {
          "command": "pairNotebook.vpsFolderPrivate",
          "when": "resourceScheme == pair-vps && explorerResourceIsFolder && pairNotebook.vpsOwner",
          "group": "pairNotebook@2"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "pairNotebook.runActiveCell",
          "group": "navigation@20",
          "when": "(pairNotebook.inSession && pairNotebook.executionAvailable) || pairNotebook.inVpsSession"
        }
      ],
      "view/title": [],
      "editor/context": [
        {
          "command": "pairNotebook.addLineComment",
          "when": "(pairNotebook.inSession || pairNotebook.inVpsSession) && (resourceScheme == file || resourceScheme == pair-vps || resourceScheme == vscode-notebook-cell)",
          "group": "pairNotebook@1"
        },
        {
          "command": "pairNotebook.resolveLineComment",
          "when": "pairNotebook.inSession || pairNotebook.inVpsSession",
          "group": "pairNotebook@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pairNotebook.connectVpsCompute",
          "when": "false"
        },
        {
          "command": "pairNotebook.runVpsJob",
          "when": "false"
        },
        {
          "command": "pairNotebook.showVpsJobs",
          "when": "false"
        },
        {
          "command": "pairNotebook.cancelVpsJob",
          "when": "false"
        },
        {
          "command": "pairNotebook.refreshVpsJobs",
          "when": "false"
        },
        {
          "command": "pairNotebook.startComputeSession",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Pair Notebook",
      "properties": {
        "pairNotebook.displayName": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Default name shown in the start/join prompt. Pair Notebook always asks before entering a session."
        },
        "pairNotebook.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python executable used when this computer is the session host."
        },
        "pairNotebook.selectedCudaDevice": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine",
          "description": "CUDA device index exposed to the Pair Notebook Python kernel."
        },
        "pairNotebook.persistenceDebounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "maximum": 5000,
          "scope": "application",
          "description": "Host-folder write debounce. It never delays live network updates or repeatedly force-saves the open editor."
        },
        "pairNotebook.autosaveFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Host-only local recovery folder. Empty uses C:\\Temp\\PairNotebook\\autosaves on Windows. A snapshot is created every five minutes and only the latest three are retained."
        },
        "pairNotebook.logLevel": {
          "type": "string",
          "enum": [
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "scope": "application"
        },
        "pairNotebook.turnUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Optional custom TURN relay URLs (turn:/turns:), tried in order UDP, TCP, TLS. Pair Notebook has no built-in TURN service; direct ICE and the encrypted emergency relay remain available when this is empty."
        },
        "pairNotebook.turnUsername": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Username for the custom TURN servers. Store the password with 'Pair Notebook: Set TURN Password' so it never appears in settings or logs."
        },
        "pairNotebook.proxyUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^(?:|(?:[Hh][Tt][Tt][Pp][Ss]?|[Ss][Oo][Cc][Kk][Ss](?:4[Aa]?|5[Hh]?))://(?:[^\\s:/@]+@)?(?:\\[[^\\]\\s]+\\]|[^\\s/:@?#]+)(?::[0-9]{1,5})?/?)$",
          "patternErrorMessage": "Do not put a proxy password in settings. Keep only the endpoint and optional username here, then run 'Pair Notebook: Set Proxy Password'.",
          "description": "Optional HTTP(S), SOCKS4 or SOCKS5 proxy endpoint plus optional username for signalling and encrypted relay fallback (for example http://user@127.0.0.1:10809). Store its password with 'Pair Notebook: Set Proxy Password'. Pair Notebook otherwise uses VS Code, environment and Windows system proxy settings automatically."
        },
        "pairNotebook.vpsUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "restricted": true,
          "description": "HTTPS endpoint of your own Pair Notebook server relay and durable compute service. Run Connect to Server Compute to store its team token securely. Persistent session participants instead use Connect to Server with their session password."
        },
        "pairNotebook.cursorColor": {
          "type": "string",
          "default": "",
          "pattern": "^(|#[0-9a-fA-F]{6})$",
          "description": "Cursor and line comment color. Empty selects a stable participant color."
        },
        "pairNotebook.relayUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional HTTPS Pair Notebook server relay origin for temporary sessions. Invitations carry this address automatically; no team token or guest setup is required. The last connected persistent server is used when empty."
        },
        "pairNotebook.serverRestore": {
          "type": "string",
          "enum": [
            "automatic",
            "ask",
            "manual"
          ],
          "default": "automatic",
          "scope": "application",
          "description": "Restore saved server projects automatically with bounded retries, ask once, or require an explicit connection. Explicit Leave is remembered independently."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf out",
    "compile": "rimraf out && tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --define:process.env.WS_NO_BUFFER_UTIL=\"'1'\" --define:process.env.WS_NO_UTF_8_VALIDATE=\"'1'\" --outfile=out/extension.js --sourcemap && node scripts/bundle-iroh-native.mjs && node scripts/package-build-manifest.mjs",
    "lint": "eslint .",
    "test": "npm run compile && mocha --timeout 15000 --exit \"out/test/**/*.test.js\"",
    "test:e2e": "npm run compile && node scripts/run-vscode-e2e.mjs",
    "test:vps:audit": "node scripts/vps-audit.mjs",
    "test:vps:audit:round2": "node scripts/vps-audit.mjs --round=2",
    "test:vps:agent": "python3 test/vps_agent_audit.py -q",
    "test:live": "npm run compile && node scripts/trystero-live-smoke.mjs",
    "test:live:relay": "npm run compile && node scripts/emergency-relay-live-smoke.mjs",
    "test:live:iroh": "npm run compile && node scripts/iroh-live-smoke.mjs",
    "package": "npm run clean && npm run lint && npm test && node scripts/make-artifacts.mjs --preflight-only && vsce package --no-yarn --no-dependencies --no-rewrite-relative-links --allow-missing-repository",
    "artifacts": "npm run package && node scripts/make-artifacts.mjs",
    "test:live:mqtt": "node scripts/mqtt-live-smoke.mjs",
    "vps:server": "node out/src/vps/cli.js",
    "vps:agent": "python3 scripts/pair-notebook-agent.py",
    "package:persistent-server": "node scripts/package-persistent-server.mjs",
    "test:persistent:agent": "python3 test/persistent_session_agent_test.py -q",
    "test:persistent:cpu": "python3 test/persistent_session_cpu_integration_test.py -q",
    "test:persistent:admin": "python3 test/persistent_session_admin_test.py -q",
    "test:persistent:server": "node test/persistent_server_archive_smoke.mjs",
    "vscode:uninstall": "node ./media/uninstall.cjs"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.1.0",
    "@number0/iroh": "1.1.0",
    "@trystero-p2p/core": "^0.25.3",
    "debug": "^4.4.3",
    "diff": "8.0.3",
    "dns-packet": "5.6.1",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "mqtt": "^5.15.2",
    "socks-proxy-agent": "^8.0.5",
    "trystero": "^0.25.3",
    "werift": "^0.24.4",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/dns-packet": "5.6.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "mocha": "^11.7.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
