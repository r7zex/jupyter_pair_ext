[Unit]
Description=Pair Notebook isolated interactive CPU worker
Wants=network-online.target pair-notebook-server.service
After=network-online.target pair-notebook-server.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pair-worker
Group=pair-worker
WorkingDirectory=/var/lib/pair-notebook-worker
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/usr/bin/python3 /opt/pair-notebook/server/scripts/pair-notebook-session-agent.py --url http://127.0.0.1:8787 --id vps --token-file /etc/pair-notebook/interactive-vps.token --python /opt/pair-notebook-worker-venv/bin/python --bridge /opt/pair-notebook/server/media/jupyter_kernel_bridge.py --state /var/lib/pair-notebook-worker --max-kernels 1 --share
ExecStartPre=/usr/bin/python3 /opt/pair-notebook/server/scripts/pair-notebook-session-agent.py --python /opt/pair-notebook-worker-venv/bin/python --bridge /opt/pair-notebook/server/media/jupyter_kernel_bridge.py --check-isolation
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StateDirectory=pair-notebook-worker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# This is the CPU-only VPS service. A GPU device needs a separate reviewed unit.
PrivateDevices=true
# Bubblewrap needs an unmasked /proc to mount its own private procfs.
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Bubblewrap requires unprivileged user and mount namespaces; do not restrict them.
RestrictNamespaces=false
ReadWritePaths=/var/lib/pair-notebook-worker
InaccessiblePaths=/var/lib/pair-notebook-vps /etc/pair-notebook/server.env -/etc/letsencrypt -/etc/caddy
MemoryHigh=384M
MemoryMax=512M
CPUQuota=75%
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
