# Generate independent random values; this file contains no usable credentials.
# CLIENT_TOKEN is an administrator/legacy operator credential, never an invite.
PAIR_VPS_CLIENT_TOKEN=REPLACE_WITH_ADMIN_SECRET
PAIR_VPS_AGENT_TOKENS={"vps":"REPLACE_WITH_DIFFERENT_WORKER_SECRET"}
PAIR_VPS_DATA=/var/lib/pair-notebook-vps
PAIR_VPS_BIND=127.0.0.1
PAIR_VPS_PORT=8787
