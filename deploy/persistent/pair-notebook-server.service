[Unit]
Description=Pair Notebook persistent session host and compute broker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pair-server
Group=pair-server
WorkingDirectory=/opt/pair-notebook/server
EnvironmentFile=/etc/pair-notebook/server.env
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/bin/node /opt/pair-notebook/server/out/src/vps/cli.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StateDirectory=pair-notebook-vps
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pair-notebook-vps
MemoryHigh=192M
MemoryMax=256M
CPUQuota=75%
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
